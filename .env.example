# Production on Hostinger. Recommended DATABASE_URL (absolute, outside hbuilds
# and outside public_html; set this in hPanel, without quotes):
# DATABASE_URL=file:/home/u591947527/domains/podiosync.es/data/techpodio.db
# SQLITE_PATH=/home/u591947527/domains/podiosync.es/data/techpodio.db
#
# Do not point DATABASE_URL at public_html/data/techpodio.db. A deploy can
# truncate that file to 0 bytes. On startup, a missing or <1KB durable file is
# copied from public_html/data/techpodio.db only when that fallback has a real
# size. A healthy durable file is never overwritten.
#
# Local default. On Hostinger, file:../data/techpodio.db is mapped to the
# absolute path above only by the PR #10 rewriter, and only when the process
# runs under .../hbuilds/versions/<id>/nodejs. Relative alone is not durable.
DATABASE_URL="file:../data/techpodio.db"
SQLITE_PATH=""

# Postgres later, instead of the sqlite lines above:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/techpodio"

# Canonical site URL (no trailing slash). Used for Stripe return URLs, sitemap, canonical.
PUBLIC_URL="https://podiosync.es"

# Auth.js-compatible secrets. Generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://podiosync.es"

# Stripe (test or live). Never commit real keys.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Protects POST /api/cron/expire
CRON_SECRET=""

# Created on seed only if BOTH are set. Not hardcoded.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Legal identity shown on /aviso-legal and /privacidad. Leave blank until you have them.
LEGAL_ENTITY_NAME=""
LEGAL_TAX_ID=""
LEGAL_ADDRESS=""
CONTACT_EMAIL=""

# Optional. Waitlist emails stay in the outbox until this is set.
RESEND_API_KEY=""
RESEND_FROM=""

# Optional. Ad slots stay empty until a client id exists. Scripts are not injected by default.
NEXT_PUBLIC_ADSENSE_CLIENT=""
