# SQLite file, path relative to prisma/schema.prisma
DATABASE_URL="file:../data/techpodio.db"

# Canonical site URL (no trailing slash). Used for Stripe return URLs, sitemap, canonical.
PUBLIC_URL="https://podiosync.es"

# Auth.js-compatible secrets. Generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://podiosync.es"

# Stripe (test or live). Never commit real keys.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Protects POST /api/cron/expire
CRON_SECRET=""

# Created on seed only if BOTH are set. Not hardcoded.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Legal identity shown on /aviso-legal and /privacidad. Leave blank until you have them.
LEGAL_ENTITY_NAME=""
LEGAL_TAX_ID=""
LEGAL_ADDRESS=""
CONTACT_EMAIL=""

# Optional. Waitlist emails stay in the outbox until this is set.
RESEND_API_KEY=""
RESEND_FROM=""

# Optional. Ad slots stay empty until a client id exists. Scripts are not injected by default.
NEXT_PUBLIC_ADSENSE_CLIENT=""
