# =============================================================================
# Hostinger Node.js — hPanel → Environment variables
# Paste these before the first build. No quotes in hPanel.
# Do not commit real values. This file is the template only.
# =============================================================================

# REQUIRED. Path is relative to prisma/schema.prisma.
# Resolves to <project>/data/techpodio.db and must survive restarts.
DATABASE_URL=file:../data/techpodio.db

# REQUIRED for this deploy.
PUBLIC_URL=https://podiosync.es
NEXTAUTH_URL=https://podiosync.es
SITE_URL=https://podiosync.es

# REQUIRED. Generate with: openssl rand -base64 32
# Use the same value for both.
AUTH_SECRET=
NEXTAUTH_SECRET=

# REQUIRED before the first `npm run build` (the seed runs inside the build).
# Admin is created only if this email does not exist yet. Password: 10+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# REQUIRED to call the expiry job.
# curl -fsS -H "Authorization: Bearer <CRON_SECRET>" https://podiosync.es/api/cron/expire
CRON_SECRET=

# REQUIRED to take payments. Leave empty and checkout stays closed (no fake charges).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Brand. Defaults are fine for https://podiosync.es.
SITE_NAME=TECHPODIO
SITE_CLAIM=Descubre las empresas que están construyendo la tecnología de Europa.
SITE_CLAIM_EN=Discover the companies building Europe’s technology.

# Legal identity. Leave blank until you have the real entity.
# Empty name, tax id, or address shows "pendiente de configuración". Never invent a CIF.
LEGAL_ENTITY_NAME=
LEGAL_TAX_ID=
LEGAL_ADDRESS=
LEGAL_JURISDICTION=
LEGAL_EMAIL=
CONTACT_EMAIL=

# Optional. Waitlist mail sends only when BOTH are set. Otherwise it stays queued.
RESEND_API_KEY=
RESEND_FROM=

# Optional. AdSense loads only after the visitor accepts advertising cookies.
NEXT_PUBLIC_ADSENSE_CLIENT=
