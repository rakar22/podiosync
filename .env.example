# SQLite file. Path is relative to prisma/schema.prisma, so this file is data/techpodio.db.
# On Hostinger Node the file must survive restarts. See HOSTINGER.md before taking live payments.
DATABASE_URL="file:../data/techpodio.db"

# Public origin. SITE_URL wins over PUBLIC_URL over NEXTAUTH_URL.
# podiosync.es is the current deploy example, not a hardcoded brand.
SITE_NAME="TECHPODIO"
SITE_URL="https://podiosync.es"
SITE_CLAIM="Descubre las empresas que están construyendo la tecnología de Europa."
SITE_CLAIM_EN="Discover the companies building Europe’s technology."
PUBLIC_URL="https://podiosync.es"
NEXTAUTH_URL="https://podiosync.es"

# openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_SECRET=""

# Stripe. Checkout refuses to open when STRIPE_SECRET_KEY is empty.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Authorization: Bearer <CRON_SECRET> on GET or POST /api/cron/expire
CRON_SECRET=""

# First seed creates this admin only if the email does not exist yet. Minimum 10 characters.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Legal pages show "pendiente de configuración" until name, tax id, and address are all set.
# Do not invent these. LEGAL_EMAIL falls back to CONTACT_EMAIL, then podio@podiosync.es.
LEGAL_ENTITY_NAME=""
LEGAL_TAX_ID=""
LEGAL_ADDRESS=""
LEGAL_JURISDICTION=""
LEGAL_EMAIL=""
CONTACT_EMAIL=""

# Waitlist mail sends only when both are set. Otherwise rows stay queued and admin says so.
RESEND_API_KEY=""
RESEND_FROM=""

# AdSense script loads only after the visitor accepts advertising cookies.
NEXT_PUBLIC_ADSENSE_CLIENT=""
