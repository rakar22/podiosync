{
  "name": "techpodio",
  "version": "1.0.0",
  "private": true,
  "description": "TECHPODIO — B2B directory of European tech companies with fixed-price sponsored ranking positions.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "NODE_ENV=production node server.js",
    "lint": "next lint",
    "test": "tsx --test src/lib/*.test.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^2.4.3",
    "jose": "^6.1.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stripe": "^17.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.4",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
